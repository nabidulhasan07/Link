/* =========================================================
   MATCHING ENGINE
   ========================================================= */
 
function calculateSkillMatch(studentSkills, requiredSkills) {
  const keys = Object.keys(requiredSkills || {});
  if (keys.length === 0) return { score: 100, matched: [], gaps: [] };
  const matched = [];
  const gaps = [];
  let ratioSum = 0;
  keys.forEach((skill) => {
    const need = requiredSkills[skill];
    const have = studentSkills[skill] || 0;
    const ratio = need > 0 ? Math.min(have / need, 1) : 1;
    ratioSum += ratio;
    if (have >= need) matched.push(skill);
    else gaps.push(skill);
  });
  return { score: Math.round((ratioSum / keys.length) * 100), matched, gaps };
}
 
function calculateInterestMatch(studentInterests, tags) {
  if (!tags || tags.length === 0) return 100;
  const overlap = tags.filter((t) => (studentInterests || []).includes(t)).length;
  return Math.round((overlap / tags.length) * 100);
}
 
function calculateEligibility(isEligible = true) {
  return isEligible ? 100 : 40;
}
 
function calculateFinalMatch(studentSkills, requiredSkills, studentInterests = [], tags = [], isEligible = true) {
  const { score: skillScore, matched, gaps } = calculateSkillMatch(studentSkills, requiredSkills);
  const interestScore = calculateInterestMatch(studentInterests, tags);
  const eligibility = calculateEligibility(isEligible);
  const final = Math.round(skillScore * 0.6 + interestScore * 0.2 + eligibility * 0.2);
  const topGap = gaps.sort((a, b) => (requiredSkills[b] - (studentSkills[b] || 0)) - (requiredSkills[a] - (studentSkills[a] || 0)))[0];
  return {
    score: final, skillScore, interestScore, eligibility, matched, gaps,
    recommendation: topGap ? `Improve ${topGap} through "${COURSES[topGap] || "a recommended course"}".` : "Fully matched — no skill gaps.",
  };
}
 
