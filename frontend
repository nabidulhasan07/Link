function SkillGapAnalysis({ skills }) {
  const rows = Object.entries(BENCHMARK).map(([skill, need]) => ({
    skill, have: skills[skill] || 0, need, ok: (skills[skill] || 0) >= need,
  }));
  const topGaps = rows.filter((r) => !r.ok).sort((a, b) => (b.need - b.have) - (a.need - a.have));
  return (
    <div className="space-y-6">
      <div className="bg-white border border-slate-200 rounded-xl p-6 flex items-center justify-between">
        <div>
          <h1 className="font-serif text-xl font-semibold text-slate-800">Your Industry Readiness</h1>
          <p className="text-sm text-slate-500">Based on your current skill profile vs. industry benchmarks</p>
        </div>
        <div className="text-center">
          <p className="text-3xl font-bold text-teal-700">{RAHUL.readiness}%</p>
          <p className="text-xs text-slate-500">Overall</p>
        </div>
      </div>
      <div className="bg-white border border-slate-200 rounded-xl overflow-hidden">
        <table className="w-full text-sm">
          <thead className="bg-slate-50 text-slate-500 text-xs uppercase">
            <tr><th className="text-left px-5 py-3">Your Skill</th><th className="text-left px-5 py-3">Your Level</th><th className="text-left px-5 py-3">Industry Need</th></tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr key={r.skill} className="border-t border-slate-100">
                <td className="px-5 py-3 font-medium text-slate-700">{r.skill}</td>
                <td className="px-5 py-3 text-slate-600">{r.have}%</td>
                <td className="px-5 py-3 flex items-center gap-2 text-slate-600">
                  {r.need}% {r.ok ? <CheckCircle2 size={14} className="text-emerald-600" /> : <AlertTriangle size={14} className="text-amber-500" />}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div className="bg-white border border-slate-200 rounded-xl p-5">
