function PostOpportunity({ onPost }) {
  const [type, setType] = useState("Internship");
  const [title, setTitle] = useState("");
  const [location, setLocation] = useState("");
  const [reqSkills, setReqSkills] = useState([{ skill: "Python", level: 70 }]);
 
  function updateSkillRow(i, field, val) {
    setReqSkills((rows) => rows.map((r, idx) => idx === i ? { ...r, [field]: val } : r));
  }
  function addRow() { setReqSkills((rows) => [...rows, { skill: SKILLS[0], level: 60 }]); }
  function submit() {
    if (!title) return;
    const required = {};
    reqSkills.forEach((r) => { required[r.skill] = Number(r.level); });
    onPost({
      id: "o" + (Date.now()), type: type.toLowerCase(), title, company: "TechNova Solutions",
      location: location || "Remote", duration: type === "Internship" ? "3 Months" : undefined,
      experience: type === "Job" ? "0-1 years" : undefined, tags: [], required,
    });
    setTitle(""); setLocation("");
  }
 
  return (
    <div className="max-w-xl">
      <h1 className="font-serif text-2xl font-semibold text-slate-800 mb-5">Post Opportunity</h1>
      <div className="bg-white border border-slate-200 rounded-xl p-6 space-y-4">
        <div>
          <label className="text-sm text-slate-600 mb-1 block">Opportunity Type</label>
          <select value={type} onChange={(e) => setType(e.target.value)} className="w-full border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-600 px-3 py-2 text-sm">
            {["Internship", "Job", "Apprenticeship", "Live Project"].map((t) => <option key={t}>{t}</option>)}
          </select>
        </div>
        <div>
          <label className="text-sm text-slate-600 mb-1 block">Title</label>
          <input value={title} onChange={(e) => setTitle(e.target.value)} placeholder="e.g. Backend Developer Intern" className="w-full border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-600 px-3 py-2 text-sm" />
        </div>
        <div>
          <label className="text-sm text-slate-600 mb-1 block">Location</label>
          <input value={location} onChange={(e) => setLocation(e.target.value)} placeholder="Remote / City" className="w-full border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-600 px-3 py-2 text-sm" />
        </div>
        <div>
          <label className="text-sm text-slate-600 mb-2 block">Required Skills</label>
          {reqSkills.map((r, i) => (
            <div key={i} className="flex gap-2 mb-2">
              <select value={r.skill} onChange={(e) => updateSkillRow(i, "skill", e.target.value)} className="flex-1 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-600 px-2 py-2 text-sm">
                {SKILLS.map((s) => <option key={s}>{s}</option>)}
              </select>
              <input type="number" value={r.level} onChange={(e) => updateSkillRow(i, "level", e.target.value)} className="w-24 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-600 px-2 py-2 text-sm" />
            </div>
          ))}
          <button onClick={addRow} className="text-xs text-teal-700 font-medium">+ Add skill</button>
        </div>
        <button onClick={submit} className="bg-teal-700 text-white px-5 py-2.5 rounded-lg font-medium hover:bg-teal-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-800 focus-visible:ring-offset-2">Publish Opportunity</button>
