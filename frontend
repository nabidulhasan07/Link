function SkillAssessment({ onComplete }) {
  const [current, setCurrent] = useState(0);
  const [answers, setAnswers] = useState({});
  const [done, setDone] = useState(false);
  const q = ASSESSMENT_QUESTIONS[current];
  const progress = Math.round(((current) / ASSESSMENT_QUESTIONS.length) * 100);
 
  function selectOption(idx) {
    setAnswers((a) => ({ ...a, [q.id]: idx }));
  }
  function next() {
    if (current < ASSESSMENT_QUESTIONS.length - 1) setCurrent(current + 1);
    else finish();
  }
  function finish() {
    const bySkill = {};
    ASSESSMENT_QUESTIONS.forEach((ques) => {
      bySkill[ques.skill] = bySkill[ques.skill] || { correct: 0, total: 0 };
      bySkill[ques.skill].total += 1;
      if (answers[ques.id] === ques.correct) bySkill[ques.skill].correct += 1;
    });
    const scores = {};
    Object.entries(bySkill).forEach(([skill, v]) => { scores[skill] = Math.round((v.correct / v.total) * 100); });
    setDone(true);
    setAnswers((a) => ({ ...a, __scores: scores }));
  }
 
  if (done) {
    const scores = answers.__scores;
    const technical = ["Python", "SQL", "Machine Learning", "Data Structures"].filter((s) => scores[s] !== undefined);
    const soft = ["Communication"].filter((s) => scores[s] !== undefined);
    return (
      <div className="max-w-2xl">
        <div className="flex items-center gap-2 text-emerald-600 mb-4">
          <CheckCircle2 size={22} /> <h1 className="font-serif text-2xl font-semibold text-slate-800">Assessment Completed</h1>
        </div>
        <div className="bg-white border border-slate-200 rounded-xl p-5 mb-4">
          <h3 className="font-semibold text-slate-700 mb-3">Technical Skills</h3>
          {technical.map((s) => <SkillBar key={s} name={s} value={scores[s]} />)}
        </div>
        <div className="bg-white border border-slate-200 rounded-xl p-5 mb-4">
          <h3 className="font-semibold text-slate-700 mb-3">Soft Skills</h3>
          {soft.map((s) => <SkillBar key={s} name={s} value={scores[s]} />)}
        </div>
        <button
          onClick={() => onComplete(scores)}
          className="bg-teal-700 text-white px-5 py-2.5 rounded-lg font-medium hover:bg-teal-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-800 focus-visible:ring-offset-2"
        >
          Apply to My Skill Profile
        </button>
        <p className="text-xs text-slate-500 mt-2">Scores are computed live from your answers in this attempt.</p>
      </div>
    );
  }
 
  return (
    <div className="max-w-xl">
      <div className="flex justify-between items-center mb-2">
        <h1 className="font-serif text-xl font-semibold text-slate-800">Question {current + 1} of {ASSESSMENT_QUESTIONS.length}</h1>
        <span className="text-sm text-slate-500">{progress}% Complete</span>
      </div>
      <div className="h-2 bg-slate-100 rounded-full mb-6 overflow-hidden">
        <div className="h-full bg-teal-600 rounded-full" style={{ width: `${progress}%` }} />
      </div>
      <div className="bg-white border border-slate-200 rounded-xl p-6">
        <p className="text-xs text-teal-700 font-medium mb-2">{q.skill}</p>
        <p className="font-medium text-slate-800 mb-5">{q.q}</p>
        <div className="space-y-2">
          {q.options.map((opt, idx) => (
            <button
              key={idx}
              onClick={() => selectOption(idx)}
              className={cx(
                "w-full text-left px-4 py-3 rounded-lg border text-sm",
                answers[q.id] === idx ? "border-teal-600 bg-teal-50 text-teal-800 font-medium" : "border-slate-200 hover:bg-slate-50 text-slate-600"
              )}
            >
              {String.fromCharCode(65 + idx)}. {opt}
            </button>
          ))}
        </div>
        <button
          onClick={next}
          disabled={answers[q.id] === undefined}
          className={cx(
            "mt-6 px-5 py-2.5 rounded-lg font-medium",
            answers[q.id] === undefined ? "bg-slate-100 text-slate-500 cursor-not-allowed" : "bg-teal-700 text-white hover:bg-teal-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-800 focus-visible:ring-offset-2"
          )}
        >
          {current < ASSESSMENT_QUESTIONS.length - 1 ? "Next" : "Submit Assessment"}
        </button>
      </div>
    </div>
  );
}
 
