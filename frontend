/* =========================================================
   APP ROOT
   ========================================================= */
 
export default function App() {
  const [role, setRole] = useState(null);
  const [view, setView] = useState("dashboard");
  const [legalPage, setLegalPage] = useState(null);
  const [sidebarOpen, setSidebarOpen] = useState(false);
  const [notifOpen, setNotifOpen] = useState(false);
  const [toasts, setToasts] = useState([]);
  const [notifications, setNotifications] = useState(NOTIFICATIONS_SEED);
  const [skills, setSkills] = useState(BASE_SKILLS);
  const [applications, setApplications] = useState(INITIAL_APPLICATIONS);
  const [opportunities, setOpportunities] = useState(INITIAL_OPPORTUNITIES);
  const [shortlist, setShortlist] = useState({});
 
  function pushToast(text) {
    const id = Date.now();
    setToasts((t) => [...t, { id, text }]);
    setTimeout(() => setToasts((t) => t.filter((x) => x.id !== id)), 3000);
  }
  function pushNotification(text) {
    setNotifications((n) => [{ id: Date.now(), text, time: "Just now" }, ...n]);
  }
 
  function handleLogin(r) {
    setRole(r); setView("dashboard");
    pushToast(`Logged in as ${ROLE_LABEL[r]}`);
  }
 
  function handleApply(opp, score) {
    setApplications((apps) => [...apps, {
      id: "a" + Date.now(), studentId: "s1", opportunityId: opp.id,
      matchScore: score, status: "Applied", appliedDate: new Date().toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" }),
    }]);
    pushToast(`Applied to ${opp.title}`);
    pushNotification(`Your application to ${opp.title} was submitted.`);
  }
 
  function handleAssessmentComplete(scores) {
    setSkills((s) => ({ ...s, ...scores }));
    pushToast("Skill profile updated");
    setView("dashboard");
  }
 
  function handlePost(newOpp) {
    setOpportunities((o) => [newOpp, ...o]);
    pushToast("Opportunity published");
  }
 
  function handleShortlist(studentId, oppId) {
    setShortlist((s) => ({ ...s, [studentId + oppId]: true }));
    setApplications((apps) => apps.map((a) => a.studentId === studentId && a.opportunityId === oppId ? { ...a, status: "Shortlisted" } : a));
    pushToast("Candidate shortlisted");
  }
 
  function handleStatusChange(appId, status) {
    setApplications((apps) => apps.map((a) => a.id === appId ? { ...a, status } : a));
  }
 
  if (legalPage) {
    const back = () => setLegalPage(null);
    return legalPage === "privacy" ? <PrivacyPolicy onBack={back} />
      : legalPage === "terms" ? <TermsAndConditions onBack={back} />
      : <CookiePolicy onBack={back} />;
  }
 
  if (!role) {
    return (
      <div>
        <Landing onGetStarted={() => setView("__login")} onOpenLegal={setLegalPage} />
        {view === "__login" && (
          <div className="fixed inset-0 bg-white z-40 overflow-y-auto">
            <Login onLogin={handleLogin} />
          </div>
        )}
      </div>
    );
  }
 
  let page;
  if (role === "student") {
    if (view === "dashboard") page = <StudentDashboard skills={skills} applications={applications} setView={setView} />;
    else if (view === "assessment") page = <SkillAssessment onComplete={handleAssessmentComplete} />;
    else if (view === "my-skills") page = <MySkills skills={skills} />;
    else if (view === "skill-gaps") page = <SkillGapAnalysis skills={skills} />;
    else if (view === "recommended") page = <Recommended skills={skills} applications={applications} onApply={handleApply} />;
    else if (view === "internships") page = <OpportunityList skills={skills} applications={applications} onApply={handleApply} type="internship" />;
    else if (view === "jobs") page = <OpportunityList skills={skills} applications={applications} onApply={handleApply} type="job" />;
    else if (view === "applications") page = <Applications applications={applications} />;
    else if (view === "learning") page = <Learning skills={skills} />;
    else if (view === "portfolio") page = <Portfolio skills={skills} />;
    else if (view === "profile") page = <Profile />;
  } else if (role === "industry") {
    if (view === "dashboard") page = <IndustryDashboard applications={applications} opportunities={opportunities} />;
    else if (view === "company-profile") page = <CompanyProfile />;
    else if (view === "post-opportunity") page = <PostOpportunity onPost={handlePost} />;
    else if (view === "my-opportunities") page = <MyOpportunities opportunities={opportunities} />;
    else if (view === "candidates") page = <Candidates opportunities={opportunities} shortlist={shortlist} onShortlist={handleShortlist} />;
    else if (view === "applications") page = <IndustryApplications applications={applications} onStatusChange={handleStatusChange} />;
    else if (view === "mentorship") page = <SimpleCardList title="Mentorship" items={MENTOR_REQUESTS} />;
    else if (view === "projects") page = <SimpleCardList title="Projects" items={LIVE_PROJECTS} />;
  } else if (role === "academician") {
    if (view === "dashboard") page = <AcademicianDashboard />;
    else if (view === "profile") page = <Profile />;
    else if (view === "fdps") page = <SimpleCardList title="Faculty Development Programmes" items={FDPS} />;
    else if (view === "training") page = <SimpleCardList title="Industrial Training" items={TRAININGS} />;
    else if (view === "research") page = <SimpleCardList title="Research Collaboration" items={RESEARCH} />;
    else if (view === "mentorship") page = <SimpleCardList title="Mentorship Requests" items={MENTOR_REQUESTS} />;
    else if (view === "lectures") page = <SimpleCardList title="Guest Lectures" items={GUEST_LECTURES} />;
    else if (view === "projects") page = <SimpleCardList title="Live Projects" items={LIVE_PROJECTS} />;
  } else if (role === "institution") {
    if (view === "dashboard") page = <InstitutionDashboard />;
    else if (view === "students") page = <StudentsTable />;
    else if (view === "skill-analytics") page = <SkillAnalyticsPage />;
    else if (view === "industry-demand") page = <IndustryDemandChart />;
    else if (view === "placements") page = <PlacementsPage />;
    else if (view === "departments") page = <DepartmentsPage />;
    else if (view === "reports") page = <ReportsPage />;
  }
 
  return (
    <div className="min-h-screen bg-slate-50 flex">
      <Sidebar role={role} view={view} setView={setView} open={sidebarOpen} setOpen={setSidebarOpen} />
      <div className="flex-1 flex flex-col min-w-0">
        <Navbar role={role} setRole={setRole} sidebarOpen={sidebarOpen} setSidebarOpen={setSidebarOpen} notifications={notifications} notifOpen={notifOpen} setNotifOpen={setNotifOpen} />
        <main className="flex-1 p-4 md:p-8 overflow-y-auto" onClick={() => notifOpen && setNotifOpen(false)}>
          {page}
        </main>
      </div>
      <Toasts toasts={toasts} />
    </div>
  );
}
 






